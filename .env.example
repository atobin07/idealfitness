# Supabase — copy to .env.local and fill in from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Web Push — the public half of the VAPID keypair (generate with
# `npx web-push generate-vapid-keys`). The private key is never used by the
# Next.js app; it lives only as a secret on the send-push Edge Function.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
